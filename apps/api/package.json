{
  "name": "@apps/api",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf gen node_modules *.tsbuildinfo",
    "build": "tsup --format esm --out-dir dist server.ts",
    "dev": "tsx watch server.ts",
    "lint": "eslint .",
    "format": "prettier --check .",
    "fix": "eslint . --fix && prettier --write .",
    "tsc": "tsc -noEmit -p .",
    "test": "glob **/*.test.ts -c 'LOGGING_DISABLED=1 node --import tsx --test --test-reporter=spec'",
    "test-ix": "glob **/*.ix_test.ts -c 'LOGGING_DISABLED=1 node --import tsx --test --test-concurrency=1 --test-reporter=spec'",
    "kysely-codegen": "kysely-codegen",
    "delete-user": "tsx scripts/delete-user.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.474.0",
    "@aws-sdk/client-sesv2": "^3.592.0",
    "@connectrpc/connect": "^1.4.0",
    "@connectrpc/connect-fastify": "^1.4.0",
    "@connectrpc/connect-node": "^1.4.0",
    "@fast-csv/format": "^4.3.5",
    "@fastify/cors": "^8.4.0",
    "@fastify/helmet": "11.1.1",
    "@paralleldrive/cuid2": "^2.2.2",
    "@sindresorhus/is": "^6.3.0",
    "aws-ssl-profiles": "^1.1.2",
    "bcrypt": "^5.1.1",
    "date-fns": "^3.6.0",
    "fastify": "^4.23.2",
    "immer": "^10.1.1",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "kysely": "^0.26.3",
    "mysql2": "^3.6.1",
    "neverthrow": "^6.0.0",
    "pino-pretty": "^11.2.2",
    "sql-formatter": "^15.3.2",
    "sql-highlight": "^6.0.0",
    "tiny-invariant": "^1.3.1",
    "ts-custom-error": "^3.3.1",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.34.0",
    "@bufbuild/protobuf": "^1.10.0",
    "@bufbuild/protoc-gen-es": "^1.10.0",
    "@connectrpc/protoc-gen-connect-es": "^1.4.0",
    "@trivago/prettier-plugin-sort-imports": "^4.2.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.3",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "eslint": "^8.36.0",
    "eslint-config-prettier": "^9.0.0",
    "glob": "^10.3.10",
    "kysely-codegen": "^0.11.0",
    "msw": "^2.6.5",
    "prettier": "^3.0.3",
    "tsup": "^7.2.0",
    "tsx": "^4.6.2",
    "typescript": "^5.2.2"
  }
}
