{
  "editor.formatOnSave": true,
  "editor.rulers": [100, 120],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.fixAll.stylelint": "explicit"
  },
  "files.insertFinalNewline": true,
  // Buf
  "buf.binaryPath": "./node_modules/.bin/buf",
  // Node/NPM
  "npm.packageManager": "pnpm",
  // ESLint
  "eslint.codeAction.showDocumentation": {
    "enable": true
  },
  "eslint.workingDirectories": [
    "./apps/api",
    "./apps/web",
    "./infrastructures"
  ],
  "eslint.run": "onSave",
  // Prettier
  // "prettier.documentSelectors": [".", "migrations/*.sql"],
  "prettier.documentSelectors": [
    "./apps/api",
    "./apps/web",
    "./infrastructures"
  ],
  "tailwindCSS.experimental.configFile": "./apps/web/tailwind.config.ts",
  // Make Tailwind CSS IntelliSense work not only for className props
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["[cC]lassName: ([^,]*)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["[cC]lassName = (.*)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["[cC]lassNames = {([^}]*)}", "[\"'`]([^\"'`]*).*?[\"'`]"]
  ],
  // Languages
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  // "[sql]": {
  //   "editor.defaultFormatter": "esbenp.prettier-vscode"
  // },
  // Workaround
  // https://github.com/microsoft/vscode/issues/103163#issuecomment-672272020
  "css.lint.unknownAtRules": "ignore",
  // Code Spell Checker
  "cSpell.ignorePaths": [
    ".vscode/settings.json",
    "apps/api/gen",
    "apps/web/gen"
  ],
  "cSpell.words": [
    "clematite",
    "clsx",
    "connectrpc",
    "deregistration",
    "fastify",
    "immer",
    "Inno",
    "xxxcodenamexxx",
    "xxxbrandnamexxx",
    "kysely",
    "liff",
    "lucide",
    "noto",
    "proto",
    "protobuf",
    "protoc",
    "Rowset",
    "Shippori",
    "stdutils",
    "swiper",
    "tailwindcss",
    "trivago",
    "tsbuildinfo",
    "unmarshal",
    "unoptimized"
  ]
}
