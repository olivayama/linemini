# ===== ローカル開発環境専用設定 =====
# このファイルは開発環境でのみ使用されます
# 本番環境の環境変数は別途設定してください

# Google Maps API Key (開発用)
# 取得方法: https://console.cloud.google.com/
# 1. "Maps JavaScript API" を有効化
# 2. 認証情報 > APIキーを作成
# 3. 開発時は制限なし、本番時はHTTP referrersで制限
GOOGLE_MAPS_API_KEY_LOCAL=your-development-google-maps-api-key-here

# その他の開発環境変数
# NEXT_PUBLIC_APP_VERSION=1.0.0
# NEXT_PUBLIC_DEBUG_MODE=true
